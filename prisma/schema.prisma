// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model for Role-Based Access Control
model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  password            String?
  role                String   @default("PARENT")
  status              String   @default("ACTIVE") // ACTIVE, INACTIVE
  name                String
  googleEmail         String?
  googleEmailVerified Boolean  @default(false)
  theme               String   @default("light") // light | dark
  notificationsEnabled Boolean @default(true)
  sessionVersion      Int      @default(1)
  expiresAt           DateTime?
  lastLoginAt         DateTime?
  lastActivityAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relationships
  teacher          Teacher?
  parent           Parent?
  staff            Staff?
  ratings          Rating[]
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  notificationRecipients NotificationRecipient[]
  loginActivities        UserLoginActivity[]
  homeworkComments HomeworkComment[]
  complaintMessages ComplaintMessage[]
  sessions         UserSession[]

  @@index([role, status])
  @@index([googleEmail])
  @@index([status])
  @@index([createdAt])
}

// UserSession model for Single-Device Login & Auto-Logout Session Enforcement
model UserSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String    @unique
  deviceInfo    String?
  ipAddress     String?
  createdAt     DateTime  @default(now())
  lastActiveAt  DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?   // LOGIN_ELSEWHERE | IDLE_TIMEOUT | MAX_TIME | LOGOUT | PASSWORD_CHANGED | ADMIN_FORCED

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([sessionId])
  @@index([expiresAt])
}

// UserLoginActivity model for 24-hour inactivity tracking and security auditing
model UserLoginActivity {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt    DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  deviceId   String?
  deviceType String?  // Mobile, Desktop, Tablet, PWA
  browser    String?
  os         String?
  status     String   @default("SUCCESS") // SUCCESS, FAILED

  @@index([userId])
  @@index([loginAt])
}


model Student {
  id          String    @id @default(cuid())
  rollNumber  String    @unique
  admissionNo String    @unique
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  gender      String?
  bloodGroup  String?
  address     String?
  photo       String?
  isActive      Boolean   @default(true)
  batch         String?
  residenceType String?   @default("DAYSCHOLAR") // HOSTEL or DAYSCHOLAR
  enrollmentStatus String?  @default("ACTIVE") // ACTIVE, GRADUATED, RETAINED, TRANSFERRED
  graduationBatch  String?
  graduatedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  classId       String?
  class         Class?             @relation(fields: [classId], references: [id])
  parents       ParentStudent[]
  attendances   Attendance[]
  marks         Mark[]
  reportCards   ReportCard[]
  disciplinary  DisciplineRecord[]
  achievements  Achievement[]
  leaveRequests LeaveRequest[]
  complaints    Complaint[]
  promotions    PromotionAudit[]
  busAssignments BusStudent[]
  busMessages    BusMessage[]
  busMessageTargets BusMessageTarget[]
  markAuditLogs MarkAuditLog[]

  @@index([classId])
  @@index([classId, isActive])
  @@index([isActive])
  @@index([enrollmentStatus])
  @@index([createdAt])
  @@index([residenceType, isActive])
}

model Teacher {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  phone         String?
  alternatePhone String?
  qualification String?
  joinDate      DateTime?
  resumeUrl     String?
  isActive      Boolean   @default(true)
  maxPeriodsPerDay  Int   @default(6)
  maxPeriodsPerWeek Int   @default(30)

  // Relationships
  classes               Class[]
  subjects              Subject[]
  assignments           Assignment[]
  complaints            Complaint[]
  meetings              Meeting[]
  classTeacherOf        Class?              @relation("ClassTeacher")
  examRequests          ExamRequest[]
  staffExamRequests     ExamRequest[]       @relation("StaffExamRequests")
  examSubjects          ExamSubject[]
  enteredMarks          Mark[]              @relation("EnteredByStaff")
  requestSubjects       ExamRequestSubject[]
  attendances           TeacherAttendance[]
  timetableSlots        Timetable[]
  absences              TeacherAbsence[]
  absentSubstitutions   Substitution[]      @relation("AbsentTeacher")
  assignedSubstitutions Substitution[]      @relation("SubstituteTeacher")
  dispatchedExams       Exam[]              @relation("ExamDispatchedBy")
}

model Staff {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  phone       String?
  designation String?
  gender      String?
  dateOfBirth DateTime?
  address     String?
  joinDate    DateTime?
  isActive    Boolean   @default(true)

  // Relationships
  inChargeBuses Bus[]          @relation("StaffInChargeBuses")
  statusLogs    BusStatusLog[] @relation("StaffReportedStatusLogs")
  sentMessages  BusMessage[]   @relation("StaffSentBusMessages")
  attendances   StaffAttendance[]
}

model Parent {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id])
  phone      String?
  alternatePhone String?
  occupation String?
  isActive   Boolean @default(true)

  // Relationships
  children ParentStudent[]
  meetings Meeting[]
  complaints Complaint[]
}

model ParentStudent {
  parentId  String
  studentId String
  parent    Parent  @relation(fields: [parentId], references: [id])
  student   Student @relation(fields: [studentId], references: [id])

  @@id([parentId, studentId])
  @@index([studentId])
}

model Class {
  id          String  @id @default(cuid())
  name        String // e.g., "Grade 10"
  section     String // e.g., "A"
  isActive    Boolean @default(true)
  maxStrength Int     @default(40)

  // Relationships
  teacherId      String?
  teacher        Teacher?      @relation(fields: [teacherId], references: [id])
  classTeacherId String?       @unique
  classTeacher   Teacher?      @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  students       Student[]
  timetable      Timetable[]
  subjects       Subject[]
  exams          Exam[]
  examRequests   ExamRequest[]
  assignments    Assignment[]
  attendances    Attendance[]
  batchId        String?
  batch          AcademicBatch? @relation(fields: [batchId], references: [id])

  @@index([isActive])
  @@index([teacherId])
  @@index([batchId, isActive])
}

model Subject {
  id                     String  @id @default(cuid())
  name                   String
  code                   String
  maxMarks               Int     @default(100)
  passMarks              Int     @default(35)
  isActive               Boolean @default(true)
  requiredPeriodsPerWeek Int     @default(5)

  // Relationships
  classId      String
  class        Class         @relation(fields: [classId], references: [id])
  teacherId    String?
  teacher      Teacher?      @relation(fields: [teacherId], references: [id])
  marks        Mark[]
  timetable    Timetable[]
  examRequests ExamRequest[]
  examSubjects ExamSubject[]
  examRequestSubjects ExamRequestSubject[]
  assignments  Assignment[]
  reportCardSubjects ReportCardSubject[]

  @@index([classId])
  @@index([teacherId])
}

model Attendance {
  id      String   @id @default(cuid())
  date    DateTime
  status  String // PRESENT, ABSENT, LATE, HALF_DAY, LEAVE
  remarks String?

  // Relationships
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  classId   String?
  class     Class?  @relation(fields: [classId], references: [id])

  @@unique([studentId, date])
  @@index([studentId])
  @@index([classId])
  @@index([classId, date])
  @@index([date])
  @@index([date, status])
  @@index([studentId, status])
}

model TeacherAttendance {
  id        String   @id @default(cuid())
  date      DateTime
  status    String   // PRESENT, ABSENT, LEAVE, LATE, HALF_DAY
  remarks   String?

  // Relationships
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, date])
  @@index([teacherId])
  @@index([date])
  @@index([date, status])
  @@index([teacherId, status])
  @@index([createdAt])
}

model StaffAttendance {
  id        String   @id @default(cuid())
  date      DateTime
  status    String   // PRESENT, ABSENT, LEAVE, LATE, HALF_DAY
  remarks   String?

  // Relationships
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, date])
  @@index([staffId])
  @@index([date])
  @@index([date, status])
  @@index([staffId, status])
  @@index([createdAt])
}

model Exam {
  id             String         @id @default(cuid())
  name           String
  date           DateTime       @default(now())
  isPublished    Boolean        @default(false)
  requestId      String?        @unique
  request        ExamRequest?   @relation(fields: [requestId], references: [id])
  classId        String
  class          Class          @relation(fields: [classId], references: [id])
  sectionId      String?
  academicYearId String?
  academicYear   AcademicBatch? @relation(fields: [academicYearId], references: [id])
  status              String         @default("MARKS_IN_PROGRESS") // MARKS_IN_PROGRESS | SUBMITTED | VERIFIED | PUBLISHED
  dispatchedByStaffId String?
  dispatchedByStaff   Teacher?       @relation("ExamDispatchedBy", fields: [dispatchedByStaffId], references: [id])
  dispatchedAt        DateTime?
  studentCount        Int?
  normalizedName      String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt

  marks          Mark[]
  reportCards    ReportCard[]
  examSubjects   ExamSubject[]

  @@index([classId])
  @@index([classId, name])
  @@index([date])
  @@index([status])
  @@index([isPublished])
  @@index([academicYearId])
  @@index([dispatchedAt])
}

model ExamSubject {
  id           String         @id @default(cuid())
  examId       String
  exam         Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject        @relation(fields: [subjectId], references: [id])
  teacherId    String?
  teacher      Teacher?       @relation(fields: [teacherId], references: [id])
  maxMarks     Int            @default(100)
  passMark     Int            @default(35)
  examDate     DateTime?
  status       String         @default("PENDING") // PENDING | DRAFT | SUBMITTED | RETURNED | VERIFIED
  submittedAt  DateTime?
  verifiedAt   DateTime?
  returnRemark String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt

  marks        Mark[]
  auditLogs    MarkAuditLog[]

  @@unique([examId, subjectId])
  @@index([examId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([status])
}

model Mark {
  id               String        @id @default(cuid())
  score            Float         @default(0)
  maxScore         Float         @default(100)
  remarks          String?
  marksObtained    Float?        // Nullable per requirement
  isAbsent         Boolean       @default(false)
  remark           String?       // Per requirement

  // Relationships
  examSubjectId    String?
  examSubject      ExamSubject?  @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student       @relation(fields: [studentId], references: [id])
  examId           String
  exam             Exam          @relation(fields: [examId], references: [id])
  subjectId        String
  subject          Subject       @relation(fields: [subjectId], references: [id])
  enteredByStaffId String?
  enteredByStaff   Teacher?      @relation("EnteredByStaff", fields: [enteredByStaffId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt

  history          MarkHistory[]
  auditLogs        MarkAuditLog[]

  @@unique([studentId, examId, subjectId])
  @@index([examSubjectId])
  @@index([studentId])
  @@index([examId])
  @@index([subjectId])
  @@index([enteredByStaffId])
  @@index([isAbsent])
}

model MarkAuditLog {
  id            String       @id @default(cuid())
  markId        String?
  mark          Mark?        @relation(fields: [markId], references: [id], onDelete: Cascade)
  examSubjectId String?
  examSubject   ExamSubject? @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  studentId     String?
  student       Student?     @relation(fields: [studentId], references: [id])
  oldValue      Float?
  newValue      Float?
  changedBy     String       // User ID or Staff ID
  reason        String
  createdAt     DateTime     @default(now())

  @@index([markId])
  @@index([examSubjectId])
  @@index([studentId])
  @@index([changedBy])
  @@index([createdAt])
}

model MarkHistory {
  id        String   @id @default(cuid())
  markId    String
  mark      Mark     @relation(fields: [markId], references: [id], onDelete: Cascade)
  oldScore  Float?
  newScore  Float
  changedBy String // ID of the user who made the change
  changedAt DateTime @default(now())

  @@index([markId])
}

model ReportCard {
  id               String    @id @default(cuid())
  totalMarks       Float
  maxTotal         Float?
  percentage       Float
  grade            String
  overallGrade     String?
  result           String?   // PASS | FAIL
  rank             Int?
  attendance       String?
  remarks          String?
  revision         Int       @default(1)
  published        Boolean   @default(false)
  dispatchedAt     DateTime?
  parentNotifiedAt DateTime?
  notifyStatus     String    @default("PENDING") // PENDING | SENT | FAILED
  parentVerified   Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  // Relationships
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id])

  subjectMarks ReportCardSubject[]
  auditLogs    ReportCardAuditLog[]

  @@unique([studentId, examId])
  @@index([studentId])
  @@index([studentId, published])
  @@index([examId, published])
  @@index([dispatchedAt])
  @@index([createdAt])
}

model ReportCardSubject {
  id           String     @id @default(cuid())
  reportCardId String
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName  String
  marks        Float?     // Nullable per rule
  maxMarks     Float      @default(100)
  passMark     Float      @default(35)
  grade        String?
  status       String?    // PASS | FAIL | ABSENT | NEEDS_REVIEW
  absent       Boolean    @default(false)
  remark       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  @@index([reportCardId])
  @@index([subjectId])
}

model ReportCardAuditLog {
  id            String     @id @default(cuid())
  reportCardId  String
  reportCard    ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  revision      Int
  changedBy     String     // User ID or Staff ID
  changedByName String?
  reason        String
  oldValues     Json?
  newValues     Json?
  createdAt     DateTime   @default(now())

  @@index([reportCardId])
  @@index([changedBy])
  @@index([createdAt])
}

model Timetable {
  id            String    @id @default(cuid())
  dayOfWeek     String // MONDAY, TUESDAY, etc.
  startTime     String // e.g., "09:00"
  endTime       String // e.g., "09:45"
  period        Int
  classroom     String?
  academicYear  String?
  isBreak       Boolean   @default(false)
  status        String    @default("PUBLISHED") // DRAFT, PUBLISHED
  slotType      String    @default("LESSON") // LESSON, BREAK, LUNCH, ASSEMBLY, FREE
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  // Relationships
  classId       String
  class         Class          @relation(fields: [classId], references: [id])
  subjectId     String?
  subject       Subject?       @relation(fields: [subjectId], references: [id])
  teacherId     String?
  teacher       Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  substitutions Substitution[]

  @@index([classId, dayOfWeek])
  @@index([subjectId])
  @@index([teacherId, dayOfWeek])
  @@index([status])
}

model PeriodSlot {
  id        String   @id @default(cuid())
  classId   String?  // null indicates school-wide default slot
  order     Int      // 1, 2, 3...
  label     String   // "Period 1", "Morning Break", "Lunch"
  startTime String   // "08:00"
  endTime   String   // "08:45"
  type      String   @default("LESSON") // LESSON, BREAK, LUNCH, ASSEMBLY, FREE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId, order])
}

model TeacherAbsence {
  id            String         @id @default(cuid())
  teacherId     String
  teacher       Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date          DateTime
  fullDay       Boolean        @default(true)
  periodNumbers String?        // comma-separated periods e.g. "1,2,3"
  reason        String?
  source        String         @default("ADMIN_MARKED") // LEAVE_APPROVED, ADMIN_MARKED
  status        String         @default("ACTIVE") // ACTIVE, CANCELLED
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  substitutions Substitution[]

  @@index([teacherId, date])
  @@index([date, status])
}

model Substitution {
  id                  String          @id @default(cuid())
  date                DateTime
  timetableEntryId    String
  timetableEntry      Timetable       @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)
  absentTeacherId     String
  absentTeacher       Teacher         @relation("AbsentTeacher", fields: [absentTeacherId], references: [id], onDelete: Cascade)
  substituteTeacherId String?
  substituteTeacher   Teacher?        @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id], onDelete: SetNull)
  absenceId           String?
  absence             TeacherAbsence? @relation(fields: [absenceId], references: [id], onDelete: Cascade)
  status              String          @default("SUGGESTED") // SUGGESTED, ASSIGNED, ACCEPTED, UNASSIGNED
  note                String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([date, timetableEntryId])
  @@index([date])
  @@index([substituteTeacherId, date])
  @@index([absentTeacherId, date])
}

model Room {
  id        String   @id @default(cuid())
  name      String   @unique
  capacity  Int?
  building  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model TimetableAudit {
  id        String   @id @default(cuid())
  action    String   // CREATE, UPDATE, DELETE, PUBLISH, IMPORT, SUBSTITUTE
  classId   String?
  userId    String
  details   String?
  createdAt DateTime @default(now())

  @@index([classId, createdAt])
}

model Assignment {
  id          String            @id @default(cuid())
  title       String
  description String?
  deadline    DateTime
  fileUrl     String?

  // Relationships
  classId     String
  class       Class             @relation(fields: [classId], references: [id])
  subjectId   String?
  subject     Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId   String
  teacher     Teacher           @relation(fields: [teacherId], references: [id])
  submissions Submission[]
  comments    HomeworkComment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  @@index([classId])
  @@index([classId, deadline])
  @@index([teacherId])
  @@index([subjectId])
  @@index([createdAt])
}

model HomeworkComment {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorName   String?
  authorRole   String?
  content      String
  createdAt    DateTime   @default(now())

  @@index([assignmentId, createdAt])
  @@index([userId])
}

model Submission {
  id          String   @id @default(cuid())
  fileUrl     String?
  text        String?
  submittedAt DateTime @default(now())
  status      String // PENDING, SUBMITTED, GRADED
  remarks     String?

  // Relationships
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String

  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@index([submittedAt])
}

model Complaint {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  severity    String
  status      String   @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED
  date        DateTime @default(now())
  remarks     String?

  // Relationships
  teacherId  String?
  teacher    Teacher? @relation(fields: [teacherId], references: [id])
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  parentId   String?
  parent     Parent?  @relation(fields: [parentId], references: [id])
  authorRole String   @default("TEACHER") // PARENT, TEACHER, ADMIN
  authorId   String?  // User ID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages   ComplaintMessage[]

  @@index([studentId])
  @@index([teacherId])
  @@index([parentId])
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

model ComplaintMessage {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorName  String
  authorRole  String    // "ADMIN", "PARENT", "TEACHER"
  content     String
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
  @@index([userId])
}

model DisciplineRecord {
  id          String   @id @default(cuid())
  incident    String
  description String
  severity    String
  actionTaken String
  date        DateTime @default(now())
  status      String

  // Relationships
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([date])
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  category    String
  date        DateTime
  description String?
  fileUrl     String?
  isVerified  Boolean  @default(false)

  // Relationships
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([date])
}

model LeaveRequest {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  reason    String
  status    String // PENDING, APPROVED, REJECTED
  fileUrl   String?

  // Relationships
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([studentId, status])
}

model Meeting {
  id       String   @id @default(cuid())
  date     DateTime
  time     String
  agenda   String
  location String?
  link     String?
  summary  String?

  // Relationships
  teachers Teacher[]
  parents  Parent[]

  @@index([date])
}

model Announcement {
  id         String    @id @default(cuid())
  title      String
  content    String
  targetType String // ALL, CLASS, PARENTS, TEACHERS
  targetId   String? // ID of specific class if applicable
  priority   String    @default("NORMAL") // LOW, NORMAL, HIGH
  expiryDate DateTime?
  fileUrl    String?
  createdAt  DateTime  @default(now())
  authorId   String

  @@index([targetType, createdAt])
  @@index([createdAt])
}

model CalendarEvent {
  id            String    @id @default(cuid())
  title         String
  type          String // EXAM, HOLIDAY, PROGRAM, MEETING, OTHER
  date          DateTime
  endDate       DateTime?
  startTime     String
  endTime       String
  location      String?
  description   String?
  targetClass   String?
  targetSection String?
  organizer     String?
  audience      String    @default("ALL") // STUDENT, TEACHER, ALL
  status        String    @default("UPCOMING") // UPCOMING, COMPLETED, CANCELLED
  isPublished   Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([date, isPublished])
  @@index([type, isPublished, date])
}

model SchoolDaySchedule {
  id               String   @id @default(cuid())
  date             DateTime @unique
  status           String   // WORKING_DAY, LEAVE_DAY
  title            String?  // e.g. "Special Working Saturday", "Diwali Holiday", "Sunday Weekend"
  reason           String?
  targetClassType  String   @default("ALL") // "ALL" or "SPECIFIC"
  targetClassIds   String?  // Comma-separated class IDs or "ALL"
  targetClassNames String?  // Human readable names e.g. "Grade 10 - A, Grade 12 - B"
  isCustom         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date, status])
}

model SchoolProgram {
  id              String   @id @default(cuid())
  name            String
  date            DateTime
  time            String
  venue           String
  description     String?
  classesInvolved String?
  coordinator     String?
  maxParticipants Int?
  registrationReq Boolean  @default(false)
  audience        String   @default("ALL") // STUDENT, TEACHER, ALL
  status          String   @default("PLANNED")
  createdAt       DateTime @default(now())

  @@index([date])
}

model SystemSetting {
  id        String   @id @default(cuid())
  category  String // GENERAL, EMAIL, NOTIFICATION, SECURITY, ACADEMIC
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Message {
  id                 String    @id @default(cuid())
  content            String
  senderId           String
  sender             User      @relation("SentMessages", fields: [senderId], references: [id])
  receiverId         String
  recipient          User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  isRead             Boolean   @default(false)
  isDeleted          Boolean   @default(false)
  deletedForSender   Boolean   @default(false)
  deletedForReceiver Boolean   @default(false)
  messageType        String    @default("TEXT") // TEXT, AUDIO, FILE, IMAGE
  fileUrl            String?
  fileName           String?
  fileSize           Int?
  fileType           String?
  duration           Int?      // in seconds for voice notes
  editedAt           DateTime?
  createdAt          DateTime  @default(now())

  @@index([receiverId, isRead])
  @@index([senderId])
  @@index([receiverId, isDeleted, isRead])
  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
  @@index([receiverId, senderId, isRead])
  @@index([createdAt])
}

model ConversationMeta {
  id          String    @id @default(cuid())
  userId      String
  otherUserId String
  clearedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, otherUserId])
  @@index([userId, otherUserId])
}

model Notification {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  title        String
  content      String
  type         String // ATTENDANCE, EXAM, HOMEWORK, MEETING, ANNOUNCEMENT, SYSTEM, BUS
  category     String?   @default("GENERAL") // BUS, ACADEMIC, SYSTEM
  priority     String?   @default("NORMAL")  // NORMAL, URGENT
  link         String?
  isRead       Boolean   @default(false)
  targetType   String?   // ALL, ROLE, CLASS, USER
  targetRole   String?
  targetGroup  String?
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  recipients   NotificationRecipient[]
  deliveryLogs NotificationDeliveryLog[]

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([userId, isRead, type])
  @@index([userId, category])
  @@index([userId, isRead, category])
  @@index([createdAt])
  @@index([scheduledFor])
}

model PushSubscription {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  deviceName String?
  platform   String?
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([endpoint])
  @@index([userId, isActive])
}

model NotificationPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(true)
  general     Boolean  @default(true)
  account     Boolean  @default(true)
  alerts      Boolean  @default(true)
  academic    Boolean  @default(true)
  admin       Boolean  @default(true)
  maintenance Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String       @default("PENDING") // PENDING, SENT, DELIVERED, FAILED
  read           Boolean      @default(false)
  readAt         DateTime?
  deliveryError  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([notificationId, userId])
  @@index([userId, read])
  @@index([notificationId, status])
}

model NotificationDeliveryLog {
  id             String        @id @default(cuid())
  notificationId String?
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  subscriptionId String?
  status         String        // SENT, FAILED, EXPIRED, UNSUBSCRIBED
  statusCode     Int?
  error          String?
  createdAt      DateTime      @default(now())

  @@index([notificationId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String // LOGIN, CREATE_USER, EDIT_MARK, etc.
  targetModel String
  targetId    String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model Rating {
  id        String   @id @default(cuid())
  rating    Int
  feedback  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ExamRequest {
  id                 String               @id @default(cuid())
  title              String               @default("Examination")
  examType           String               @default("UNIT_TEST") // UNIT_TEST, QUARTERLY, HALF_YEARLY, ANNUAL, MODEL, OTHER
  classId            String
  class              Class                @relation(fields: [classId], references: [id])
  sectionId          String?
  subjectId          String?              // Kept for backward compatibility
  subject            Subject?             @relation(fields: [subjectId], references: [id])
  teacherId          String?              // Kept for backward compatibility
  teacher            Teacher?             @relation(fields: [teacherId], references: [id])
  requestedByStaffId String?
  requestedByStaff   Teacher?             @relation("StaffExamRequests", fields: [requestedByStaffId], references: [id])
  date               DateTime             @default(now())
  startTime          String?
  endTime            String?
  maxMarks           Int                  @default(100)
  passMark           Int                  @default(35)
  examDates          String?
  remarks            String?
  status             String               @default("PENDING_ADMIN") // PENDING_ADMIN, APPROVED, REJECTED, CANCELLED
  adminRemark        String?
  declineReason      String?              // Kept for backward compatibility
  decidedBy          String?              // User ID of admin
  decidedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt

  exam               Exam?
  requestSubjects    ExamRequestSubject[]

  @@index([classId])
  @@index([teacherId])
  @@index([requestedByStaffId])
  @@index([status])
  @@index([createdAt])
}

model ExamRequestSubject {
  id        String      @id @default(cuid())
  requestId String
  request   ExamRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id])
  teacherId String?
  teacher   Teacher?    @relation(fields: [teacherId], references: [id])
  maxMarks  Int         @default(100)
  passMark  Int         @default(35)
  examDate  DateTime?

  @@unique([requestId, subjectId])
  @@index([requestId])
  @@index([subjectId])
  @@index([teacherId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  userAgent String?
  success   Boolean
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([email, timestamp])
}

model ImportBatch {
  id              String    @id @default(cuid())
  templateType    String    // STUDENT_PARENT, TEACHER
  fileName        String
  fileSize        Int?
  adminId         String?
  adminEmail      String?
  totalRows       Int       @default(0)
  validRows       Int       @default(0)
  importedRows    Int       @default(0)
  failedRows      Int       @default(0)
  skippedRows     Int       @default(0)
  status          String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, PARTIAL
  errorSummary    String?   // JSON serialized array of row issues (non-sensitive)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([templateType, startedAt])
  @@index([adminId])
}

model AcademicBatch {
  id              String           @id @default(cuid())
  name            String           @unique // e.g. "25-26" or "2025-2026"
  academicYear    String?          // e.g. "2025-2026"
  startDate       DateTime?
  endDate         DateTime?
  isCurrent       Boolean          @default(false)
  status          String           @default("ACTIVE") // UPCOMING, ACTIVE, COMPLETED, ARCHIVED
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  classes         Class[]
  exams           Exam[]
  promotionsFrom  PromotionAudit[] @relation("FromBatch")
  promotionsTo    PromotionAudit[] @relation("ToBatch")

  @@index([isCurrent])
  @@index([status])
}

model PromotionAudit {
  id              String         @id @default(cuid())
  studentId       String
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromBatchId     String?
  fromBatch       AcademicBatch? @relation("FromBatch", fields: [fromBatchId], references: [id])
  toBatchId       String?
  toBatch         AcademicBatch? @relation("ToBatch", fields: [toBatchId], references: [id])
  fromBatchName   String
  toBatchName     String
  fromClassName   String?
  toClassName     String?
  action          String         // PROMOTED, GRADUATED, RETAINED, TRANSFERRED
  promotedAt      DateTime       @default(now())
  authorizedById  String?
  remarks         String?

  @@index([studentId])
  @@index([fromBatchName, toBatchName])
  @@index([action])
}

// ==========================================
// TRANSPORTATION & BUS FLEET MANAGEMENT
// ==========================================

model Bus {
  id                 String         @id @default(cuid())
  busNumber          String         @unique // e.g. "BUS-01", "BUS-02"
  registrationNo     String         // e.g. "TN-01-AB-1234"
  name               String         // e.g. "SRT Bus 01 - North Campus Route"
  capacity           Int            @default(40)
  driverName         String
  driverPhone        String
  routeDescription   String?
  status             String         @default("RUNNING") // RUNNING | NOT_RUNNING | MAINTENANCE | DELAYED
  inChargeStaffId    String?
  inChargeStaff      Staff?         @relation("StaffInChargeBuses", fields: [inChargeStaffId], references: [id], onDelete: SetNull)
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  students           BusStudent[]
  statusLogs         BusStatusLog[]
  messages           BusMessage[]

  @@index([status])
  @@index([inChargeStaffId])
  @@index([isActive])
  @@index([isActive, status])
}

model BusStudent {
  id           String   @id @default(cuid())
  busId        String
  bus          Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear String   @default("2025-2026")
  pickupPoint  String?
  dropPoint    String?
  assignedAt   DateTime @default(now())

  @@unique([studentId, academicYear])
  @@index([busId])
  @@index([studentId])
  @@index([assignedAt])
  @@index([busId, academicYear])
}

model BusStatusLog {
  id                String   @id @default(cuid())
  busId             String
  bus               Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  status            String   // RUNNING | NOT_RUNNING | MAINTENANCE | DELAYED
  issueType         String?  // BREAKDOWN | TRAFFIC | ACCIDENT | LATE | ROUTE_CHANGE | OTHER
  description       String
  reportedByStaffId String?
  reportedByStaff   Staff?   @relation("StaffReportedStatusLogs", fields: [reportedByStaffId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())

  @@index([busId])
  @@index([status])
  @@index([createdAt])
  @@index([busId, createdAt])
  @@index([reportedByStaffId])
}

model BusMessage {
  id              String   @id @default(cuid())
  busId           String
  bus             Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  senderStaffId   String?
  senderStaff     Staff?   @relation("StaffSentBusMessages", fields: [senderStaffId], references: [id], onDelete: SetNull)
  type            String   @default("COMMON") // COMMON | INDIVIDUAL
  title           String
  message         String
  priority        String   @default("NORMAL") // NORMAL | URGENT
  targetStudentId String?
  targetStudent   Student? @relation(fields: [targetStudentId], references: [id], onDelete: SetNull)
  targets         BusMessageTarget[]
  createdAt       DateTime @default(now())

  @@index([busId])
  @@index([createdAt])
  @@index([busId, createdAt])
  @@index([busId, type])
  @@index([targetStudentId])
  @@index([senderStaffId])
}

model BusMessageTarget {
  id           String      @id @default(cuid())
  busMessageId String
  busMessage   BusMessage  @relation(fields: [busMessageId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@unique([busMessageId, studentId])
  @@index([busMessageId])
  @@index([studentId])
}

model SettingsSecurity {
  id              String    @id @default(cuid())
  passwordHash    String
  passwordVersion Int       @default(1)
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  updatedAt       DateTime  @updatedAt
  updatedByUserId String?

  @@index([passwordVersion])
}

// Outbox Pattern for Non-blocking Asynchronous Replication to Secondary DB (Supabase)
model SyncOutbox {
  id         String    @id @default(cuid())
  modelName  String
  recordId   String
  action     String    // CREATE, UPDATE, DELETE
  payload    Json?
  status     String    @default("PENDING") // PENDING, SYNCED, FAILED
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  syncedAt   DateTime?
  error      String?

  @@index([status, createdAt])
  @@index([modelName, recordId])
}
