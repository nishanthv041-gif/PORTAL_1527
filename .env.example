# ==============================================================================
# SRT SCHOOL PORTAL - PRODUCTION ENVIRONMENT VARIABLES (VERCEL & RENDER)
# ==============================================================================

# 1. PostgreSQL Database Connection (Required)
# Use Neon, Supabase, Render PostgreSQL, or AWS RDS
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# 2. NextAuth Authentication (Required)
# Generate a strong 32+ char key with: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-random-secret"

# Canonical URL for NextAuth & Callback redirects
# - On Vercel: https://nipoportal.vercel.app (or custom domain)
# - On Render: https://your-app-name.onrender.com
NEXTAUTH_URL="https://nipoportal.vercel.app"
NEXT_PUBLIC_APP_URL="https://nipoportal.vercel.app"

# 3. Admin Settings Security Master Password (Required)
# Seeds the database with the hashed password on first boot
SETTINGS_INITIAL_PASSWORD="srtschool1527"

# 4. Google OAuth 2.0 Credentials (Optional / for Google Login)
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 5. Email Notifications & Alerts (Nodemailer / SMTP)
SMTP_EMAIL="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"

# 6. Gemini Vision AI API Key (For Timetable & Gradebook OCR Extraction)
# Generate from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 7. Internal Cron Job Secret (Required for automated DB cleanup)
CRON_SECRET="your-random-cron-secret-key"

# 8. Node Environment
NODE_ENV="production"
