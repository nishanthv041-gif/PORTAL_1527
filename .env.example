DATABASE_URL="postgresql://user:password@host:port/database" # Use a PostgreSQL connection string for Vercel/Production
NEXTAUTH_SECRET="<your-generated-secret-here>"
NEXTAUTH_URL="http://localhost:3000" # Update to your production URL on Vercel/Render

# Google OAuth for Sign-In
GOOGLE_CLIENT_ID="<your-google-client-id>"
GOOGLE_CLIENT_SECRET="<your-google-client-secret>"

# Nodemailer / SMTP Email Alerts
SMTP_EMAIL="your-email@gmail.com"
SMTP_PASSWORD="<your-16-char-app-password>"

# Google Gemini API (for In-Memory Report Card & Timetable OCR / Vision Document Extraction)
# Generate key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="<your-gemini-api-key>"
