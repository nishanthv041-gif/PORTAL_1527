# ==============================================================================
# SRT SCHOOL PORTAL - PRODUCTION ENVIRONMENT VARIABLES (VERCEL & RENDER)
# ==============================================================================

# 1. Primary PostgreSQL Database Connection (Neon Singapore - Pooled for runtime)
DATABASE_URL="postgresql://user:password@ep-host-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-host.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 1b. Secondary PostgreSQL Database & Failover Backup (Supabase Ireland)
SECONDARY_DATABASE_URL="postgresql://postgres.project:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
SECONDARY_DIRECT_URL="postgresql://postgres.project:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase Storage & Client API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# 2. NextAuth Authentication (Required)
# Generate a strong 32+ char key with: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-random-secret"

# Canonical URL for NextAuth & Callback redirects
# - On Vercel: https://nipoportal.vercel.app (or custom domain)
# - On Render: https://your-app-name.onrender.com
NEXTAUTH_URL="https://nipoportal.vercel.app"
NEXT_PUBLIC_APP_URL="https://nipoportal.vercel.app"

# 3. Admin Settings Security Master Password (Required)
# Seeds the database with the hashed password on first boot
SETTINGS_INITIAL_PASSWORD="srtschool1527"

# 4. Google OAuth 2.0 Credentials (Optional / for Google Login)
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 5. Email Notifications & Alerts (Nodemailer / SMTP)
SMTP_EMAIL="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"

# 6. Gemini Vision AI API Key (For Timetable & Gradebook OCR Extraction)
# Generate from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 7. Internal Cron Job Secret (Required for automated DB cleanup & sync)
CRON_SECRET="your-random-cron-secret-key"

# 8. AWS Infrastructure & Storage (Singapore ap-southeast-1)
AWS_REGION="ap-southeast-1"
S3_STORAGE_BUCKET="" # Name of the private S3 bucket created by Terraform (e.g. nipoportal-storage-xxxx)
ECR_REPO_URL=""      # ECR repository URL (e.g. 123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/nipoportal-app)
DOMAIN=""            # Optional custom domain (e.g. portal.myschool.edu); leave empty to use server IP

# 9. Node Environment
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"

